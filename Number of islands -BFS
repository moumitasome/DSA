Number of islands BFS

import java.util.Scanner;
import java.util.*;

public class Main {

    public static void bfs(char[][] grid,  int r, int c, boolean[][] visited) {
        Queue<int[]> q = new LinkedList<>();
        q.offer(new int[]{r , c});
        visited[r][c] = true;
        int[][] direction = {{-1,0},{1,0},{0,-1},{0,1}};
        while(!q.isEmpty()){
          int[] current = q.poll();
          int curR = current[0];
          int curC = current[1];

          for(int[] dir : direction){
            int nr = r + dir[0];
            int nc = c + dir[1];

            /*
            1. Bounday Check 
            2. It is land or not 
            3. Already visited or not
            */
             if(nr >= 0 && nr < r  &&
                 nc >= 0 && nc < c &&
                 grid[nr][nc] == '1' &&
                 !visited[nr][nc]){
                    visited[nr][nc] = true;
                    q.offer(new int[]{nr , nc});
                 }
          }


        }
       
    
    }

    public static int getIsland(char[][]grid){
        int n  = grid.length;
        int m = grid[0].length;

        int islandCount =0;
        boolean[][] visited = new boolean[n][m];

        for(int r = 0 ; r < n ; r++){
            for(int c = 0 ; c < n ; c++){
                if(grid[r][c] =='1'&& !visited[r][c]){
                    islandCount++;
                    bfs(grid , r , c , visited);
                }
            }
        }
        return islandCount;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int rows = sc.nextInt();
        int cols = sc.nextInt();

        char[][] grid = new char[rows][cols];
        for(int i = 0 ; i< rows ; i++){
            for(int j = 0 ; j<cols ; j++){
                grid[i][j] = sc.next().charAt(0);
            }
        }

        System.out.println(getIsland(grid));
    }
}
