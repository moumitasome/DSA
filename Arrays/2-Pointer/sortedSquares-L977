class Solution {
    public int[] sortedSquares(int[] nums) {
        int n = nums.length;
        int left =0 ;
        int right = n- 1;
        int index = n -1;

        int[] res = new int[n];

        while(left <= right){  // We need to process every element, including the middle element when both pointers meet. so = is require here.

            int leftSq = nums[left] *  nums[left];
            int rightSq = nums[right] *  nums[right];

            if(leftSq > rightSq){
                res[index] = leftSq;
                left++;
            }else{

                res[index] = rightSq;
                right--;
            }

            index --;

        }

      return res;
        
        
    }
}
