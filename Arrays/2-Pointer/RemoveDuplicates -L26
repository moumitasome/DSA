class Solution {
    public int removeDuplicates(int[] nums) {
        int left = 0;
        int right = 1;

        // [1, 1, 2, 2, 3] --> [ 1, 2 , 3 ]

        while(right < nums.length){ // Always check the fastest moving pointer in your while condition here right:

             if(nums[left] == nums[right]){  // nums[0] == nums[1]  --> nums[0] = 1 and nums[1] = 1 -- Yes  , step 2: left = 0 , right =2 , 
                right ++ ;  //  [1, 1, 2  (right), 2, 3]
             }else{                          
                left++; // left = 1
                nums[left] = nums[right]; // 1 =
                right++;
             }
        }

        return left+1 ;
    }
}
